diff --git a/src/stock.js b/src/stock.js
--- a/src/stock.js
+++ b/src/stock.js
@@ -77,6 +77,17 @@
     for (const item of this._items.values()) total += item.quantity;
     return total;
   }
+
+  /**
+   * Whether an item with the SKU is in stock (known, even at zero units).
+   * @param {string} sku SKU.
+   * @returns {boolean} True when the SKU is known.
+   * @throws {TypeError} When sku is not a string.
+   */
+  contains(sku) {
+    if (typeof sku !== 'string') throw new TypeError('sku must be a string');
+    return this._items.has(sku);
+  }
 }
 
 module.exports = { Stock };
diff --git a/tests/stockTests.js b/tests/stockTests.js
