 }
 
-module.exports = { stockAddSameSkuMergesQuantity, stockRemoveReducesQuantity, stockRemoveUnknownSkuThrows };
+/**
+ * contains finds a known SKU and not an unknown one.
+ */
+function stockContainsKnownAndUnknown() {
+  const stock = new Stock();
+  stock.add(new Item('A-1', 'Anchor', 1, 0));
+  assert.equal(stock.contains('A-1'), true);
+  assert.equal(stock.contains('B-1'), false);
+}
+
+module.exports = {
+  stockAddSameSkuMergesQuantity,
+  stockRemoveReducesQuantity,
+  stockRemoveUnknownSkuThrows,
+  stockContainsKnownAndUnknown
+};
