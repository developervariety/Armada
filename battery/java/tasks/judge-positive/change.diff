+
+    /**
+     * Whether an item with the SKU is in stock (known, even at zero units).
+     * @param sku SKU.
+     * @return True when the SKU is known.
+     * @throws NullPointerException When sku is null.
+     */
+    public boolean contains(String sku) {
+        Objects.requireNonNull(sku, "sku");
+        return items.containsKey(sku);
+    }
 }
