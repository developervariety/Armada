+//! Reorder suggestions.
+
+use crate::stock::Stock;
+
+/// Suggests which items to reorder.
+pub struct Reorder {
+    threshold: u32,
+}
+
+impl Reorder {
+    /// Creates a reorder policy that reorders when fewer units than `threshold` are on hand.
+    pub fn new(threshold: u32) -> Reorder {
+        Reorder { threshold }
+    }
+
+    pub fn suggest(&self, stock: &Stock, skus: &[&str]) -> Vec<String> {
+        let mut reorderList = Vec::new();
+        for sku in skus {
+            let item = stock.find(sku).unwrap();
+            if item.quantity < self.threshold {
+                println!("Reorder {}", sku);
+                reorderList.push(sku.to_string());
+            }
+        }
+        reorderList
+    }
+}
