@@ -24,3 +24,11 @@
     let mut stock = Stock::new();
     assert_eq!(Err(InventoryError::UnknownSku("missing".to_string())), stock.remove("missing", 1));
 }
+
+/// contains finds a known SKU and not an unknown one.
+pub fn stock_contains_known_and_unknown() {
+    let mut stock = Stock::new();
+    stock.add(Item::new("A-1", "Anchor", 100, 0).expect("valid item"));
+    assert!(stock.contains("A-1"), "A-1 should be known");
+    assert!(!stock.contains("B-1"), "B-1 should be unknown");
+}
