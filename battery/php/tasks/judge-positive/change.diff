+
+    /**
+     * Whether an item with the SKU is in stock (known, even at zero units).
+     *
+     * @param string $sku SKU.
+     * @return bool True when the SKU is known.
+     */
+    public function contains(string $sku): bool
+    {
+        return array_key_exists($sku, $this->items);
+    }
 }
