+
+        /// <summary>
+        /// Contains finds a known SKU and not an unknown one.
+        /// </summary>
+        public static void Stock_Contains_KnownAndUnknown()
+        {
+            Stock stock = new Stock();
+            stock.Add(new Item("A-1", "Anchor", 1m, 0));
+            Check.True(stock.Contains("A-1"), "A-1 should be known.");
+            Check.True(!stock.Contains("B-1"), "B-1 should be unknown.");
+        }
     }
 }
