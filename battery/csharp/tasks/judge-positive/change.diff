diff --git a/src/Inventory/Stock.cs b/src/Inventory/Stock.cs
--- a/src/Inventory/Stock.cs
+++ b/src/Inventory/Stock.cs
@@ -76,5 +76,17 @@ namespace Inventory
             foreach (Item item in _Items.Values) total += item.Quantity;
             return total;
         }
+
+        /// <summary>
+        /// Whether an item with the SKU is in stock (known, even at zero units).
+        /// </summary>
+        /// <param name="sku">SKU.</param>
+        /// <returns>True when the SKU is known.</returns>
+        /// <exception cref="ArgumentNullException">Thrown when sku is null.</exception>
+        public bool Contains(string sku)
+        {
+            if (sku == null) throw new ArgumentNullException(nameof(sku));
+            return _Items.ContainsKey(sku);
+        }
     }
 }
