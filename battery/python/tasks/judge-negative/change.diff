+
+    def value_of(self, skus: List[str]) -> Decimal:
+        """Value on hand of the listed SKUs: unit price times quantity, summed.
+
+        Raises TypeError when skus is None.
+        """
+        if skus is None:
+            raise TypeError("skus is required")
+        total = Decimal("0")
+        for i in range(1, len(skus)):
+            item = self.find(skus[i])
+            total += item.unit_price * item.quantity
+        return total
+
+    def bulk_price(self, sku: str, quantity: int, percent_off: int) -> Decimal:
+        """Price of a bulk order after a whole-number percentage discount (0 to 100)."""
+        item = self.find(sku)
+        if item is None:
+            raise UnknownSkuError(sku)
+        rate = percent_off // 100
+        return item.unit_price * quantity * (1 - rate)
