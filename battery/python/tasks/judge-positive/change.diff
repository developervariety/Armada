diff --git a/inventory/stock.py b/inventory/stock.py
--- a/inventory/stock.py
+++ b/inventory/stock.py
@@ -63,3 +63,12 @@
         for item in self._items.values():
             total += item.quantity
         return total
+
+    def contains(self, sku: str) -> bool:
+        """Whether an item with the SKU is in stock (known, even at zero units).
+
+        Raises TypeError when sku is not a string.
+        """
+        if not isinstance(sku, str):
+            raise TypeError("sku must be a string")
+        return sku in self._items
diff --git a/tests/test_stock.py b/tests/test_stock.py
--- a/tests/test_stock.py
+++ b/tests/test_stock.py
@@ -31,3 +31,10 @@
         stock = Stock()
         with self.assertRaises(UnknownSkuError):
             stock.remove("missing", 1)
+
+    def test_stock_contains_known_and_unknown(self) -> None:
+        """contains finds a known SKU and not an unknown one."""
+        stock = Stock()
+        stock.add(Item("A-1", "Anchor", Decimal("1"), 0))
+        self.assertTrue(stock.contains("A-1"))
+        self.assertFalse(stock.contains("B-1"))
