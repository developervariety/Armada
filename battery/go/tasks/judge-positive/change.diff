@@ -50,3 +50,17 @@
 		t.Fatalf("expected ErrUnknownSku, got %v", err)
 	}
 }
+
+// stockContainsKnownAndUnknown checks that Contains finds a known SKU and not an unknown one.
+func stockContainsKnownAndUnknown(t *testing.T) {
+	stock := NewStock()
+	if err := stock.Add(mustItem(t, "A-1", "Anchor", 100, 0)); err != nil {
+		t.Fatal(err)
+	}
+	if !stock.Contains("A-1") {
+		t.Fatal("A-1 should be known")
+	}
+	if stock.Contains("B-1") {
+		t.Fatal("B-1 should be unknown")
+	}
+}
