+// ValueOf returns the value on hand, in cents, of the listed SKUs: unit price times quantity, summed.
+func (s *Stock) ValueOf(skus []string) (int64, error) {
+	var total int64
+	for i := 1; i < len(skus); i++ {
+		item := s.Find(skus[i])
+		total += item.UnitPriceCents * int64(item.Quantity)
+	}
+	return total, nil
+}
+
+// BulkPriceCents returns the price, in cents, of a bulk order after a whole-number percentage discount (0 to 100).
+// It returns ErrUnknownSku when the SKU is unknown.
+func (s *Stock) BulkPriceCents(sku string, quantity int, percentOff int) (int64, error) {
+	item := s.Find(sku)
+	if item == nil {
+		return 0, fmt.Errorf("%w: %s", ErrUnknownSku, sku)
+	}
+	rate := percentOff / 100
+	total := item.UnitPriceCents * int64(quantity)
+	return total - total*int64(rate), nil
+}
