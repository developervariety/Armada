# Shell scripts must use LF line endings
*.sh text eol=lf

# Windows scripts must use CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# .NET solution and project files
*.sln text eol=crlf
*.csproj text eol=crlf

# Fixture battery packs are byte-exact data: no line-ending or encoding conversion, so the BOM/CRLF fixture
# (battery/csharp/fixture/src/Inventory/LegacyCodes.cs) and its expected result keep every byte.
battery/** -text

# Preserve concurrent release notes during landing.
CHANGELOG.md merge=union
