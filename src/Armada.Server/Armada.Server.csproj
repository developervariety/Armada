<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Admiral server for Armada multi-agent orchestration</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="6" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit suite exercise internal dispatch-path guards (CodeIndexDispatchGuard)
         directly instead of only through a full dispatch integration path. -->
    <InternalsVisibleTo Include="Test.Unit" />
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Watson" Version="7.0.15" />
    <PackageReference Include="SyslogLogging" Version="2.2.1" />
    <PackageReference Include="Radiant" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Armada.Core\Armada.Core.csproj" />
    <ProjectReference Include="..\Armada.Runtimes\Armada.Runtimes.csproj" />
  </ItemGroup>

  <!-- Populate BuildInfo.RunningCommit even in a container build that has no .git. A container
       build passes the commit as the _GitSha build-arg: use it as the source revision and turn off
       the SDK source-control query, which otherwise finds no repository and clears the revision so
       the informational version carries no commit. A normal build leaves _GitSha empty and lets the
       SDK read the commit from the working tree. -->
  <PropertyGroup Condition="'$(_GitSha)' != ''">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <SourceRevisionId>$(_GitSha)</SourceRevisionId>
  </PropertyGroup>

</Project>
