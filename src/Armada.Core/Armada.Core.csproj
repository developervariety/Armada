<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Core models, database, and services for Armada multi-agent orchestration</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the unit suite exercise internal search-cost guards (SplitQueryTerms term cap,
         ComputeLexicalScore whole-query needle length gate) directly. -->
    <InternalsVisibleTo Include="Test.Unit" />
    <InternalsVisibleTo Include="Armada.Test.Database" />
    <InternalsVisibleTo Include="Test.Shared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ArchitectSystemPrompt.md" />
    <EmbeddedResource Include="Resources\BuiltInTemplateHashes.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <!-- SqlClient's transitive PKCS minimums predate the supported security patches. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PrettyId" Version="2.0.2" />
    <PackageReference Include="SyslogLogging" Version="2.2.2" />
  </ItemGroup>

</Project>
