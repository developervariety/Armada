<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local vendored feed. Radiant 0.1.1 on nuget.org references Radiant.SemConv, which is not yet
      published there, so the telemetry stack cannot restore from nuget.org alone. Both packages are
      vendored under packages/local until Radiant.SemConv is published; remove this source and the
      folder once it is available upstream.
    -->
    <add key="armada-local" value="packages/local" />
  </packageSources>
</configuration>
