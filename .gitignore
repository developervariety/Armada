# Node tooling
node_modules/

# macOS AppleDouble / resource-fork sidecars (created on volume mounts)
._*
.DS_Store

# Operator-local context-index sidecar/reports and weekly baselines.
# Real content lives on the server at runtime and can name real vessels; never commit it.
docs/context-index/*
!docs/context-index/chunk-metadata.example.json
docs/baselines/

# Operator guide chapters are operator-local: a filled chapter names real hosts, vessels,
# accounts, and policy. Only the templates, the folder README, and the example index are tracked.
docs/ops/*
!docs/ops/README.md
!docs/ops/*.example.md
!docs/ops/INDEX.example.json
docs/ops/._*
