+        /// <summary>
+        /// Reads the JSON-RPC response carried by a POST response. A Streamable HTTP server may answer a
+        /// request with a plain JSON body or with a text/event-stream body; in the stream, the response is
+        /// the data of the event whose JSON-RPC id matches the request (other events are notifications or
+        /// requests from the server). A stream without a matching event yields its last data payload.
+        /// </summary>
+        private static async Task<string> ReadResponseJsonAsync(HttpResponseMessage httpResponse, object? requestId)
+        {
+            string body = await httpResponse.Content.ReadAsStringAsync().ConfigureAwait(false);
+            string? mediaType = httpResponse.Content.Headers.ContentType?.MediaType;
+            if (!String.Equals(mediaType, "text/event-stream", StringComparison.OrdinalIgnoreCase))
+                return body;
+
+            string? wantedId = requestId?.ToString();
+            string? lastPayload = null;
+            StringBuilder data = new StringBuilder();
+            string[] lines = body.Replace("\r\n", "\n").Split('\n');
+            for (int i = 0; i <= lines.Length; i++)
+            {
+                string? line = i < lines.Length ? lines[i] : null;
+                if (!String.IsNullOrEmpty(line))
+                {
+                    if (line.StartsWith("data:", StringComparison.Ordinal))
+                    {
+                        if (data.Length > 0) data.Append('\n');
+                        data.Append(line.Substring(5).TrimStart(' '));
+                    }
+                    continue;
+                }
+
+                // A blank line (or the end of the body) ends one event.
+                if (data.Length == 0) continue;
+                string payload = data.ToString();
+                data.Clear();
+                lastPayload = payload;
+                if (wantedId == null) continue;
+                try
+                {
+                    JsonRpcResponse? candidate = JsonSerializer.Deserialize<JsonRpcResponse>(payload);
+                    if (candidate?.Id != null && String.Equals(candidate.Id.ToString(), wantedId, StringComparison.Ordinal))
+                        return payload;
+                }
+                catch (JsonException)
+                {
+                    // Not a JSON-RPC message; keep reading.
+                }
+            }
+
+            return lastPayload ?? String.Empty;
+        }
